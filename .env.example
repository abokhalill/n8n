# Copy to .env before running: cp .env.example .env
# Every value here is a placeholder. No real credential belongs in this file or in
# any workflow export — see the secrets-handling section of the design doc.

# --- Postgres ---------------------------------------------------------------
POSTGRES_USER=leadops
POSTGRES_PASSWORD=local-dev-only-change-me
POSTGRES_PORT=5432

# --- n8n --------------------------------------------------------------------
# Must be stable across restarts or previously saved credentials become undecryptable.
N8N_ENCRYPTION_KEY=replace-with-32-plus-random-characters
N8N_PORT=5678
GENERIC_TIMEZONE=UTC
N8N_LOG_LEVEL=info

# --- Mock services ----------------------------------------------------------
MOCKS_PORT=8080

# --- Provider endpoints -----------------------------------------------------
# All five point at the mock harness. Swapping any one for a real base URL is the
# only change needed to move that integration to production.
ODOO_BASE_URL=http://mocks:8080/odoo
WHATSAPP_BASE_URL=http://mocks:8080/whatsapp
ENRICHMENT_BASE_URL=http://mocks:8080/enrich
AI_BASE_URL=http://mocks:8080/ai
BOOKING_BASE_URL=http://mocks:8080/booking

# --- Provider credentials (placeholders) ------------------------------------
ODOO_API_KEY=placeholder-odoo-api-key
ODOO_DB=placeholder-odoo-db
WHATSAPP_TOKEN=placeholder-whatsapp-token
WHATSAPP_PHONE_NUMBER_ID=placeholder-phone-number-id
AI_API_KEY=placeholder-ai-api-key

# --- Business tuning --------------------------------------------------------
# Thresholds live here rather than in workflow logic so they can be changed
# without editing and re-importing a workflow.
DEDUP_AUTO_MERGE_THRESHOLD=0.90
DEDUP_REVIEW_THRESHOLD=0.65
SCORE_QUALIFIED_MIN=70
SCORE_VIP_MIN=90
SCORE_NURTURE_MIN=40
SLA_MINUTES=30
VIP_APPROVAL_TIMEOUT_MINUTES=30

# --- Retry policy -----------------------------------------------------------
RETRY_MAX_ATTEMPTS=5
RETRY_BASE_MS=2000
RETRY_CAP_MS=900000
CLAIM_STALE_SECONDS=120
HTTP_TIMEOUT_MS=5000
