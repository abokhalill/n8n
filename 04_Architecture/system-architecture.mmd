%% System architecture — lead processing pipeline
%% Solid arrows = data/control flow. Dashed = state reads/writes.
flowchart TB

  subgraph EXT["External systems — all mocked (Phase 2)"]
    direction LR
    SWEB["Website form"]
    SWA["WhatsApp inbound"]
    SCSV["CSV / manual import"]
    CAL["Booking provider"]
    MGR["Manager approval callback"]
  end

  subgraph PROV["Outbound providers — mocked, fault-injectable"]
    direction LR
    ENR["Enrichment API"]
    LLM["LLM classifier"]
    MSG["WhatsApp / email send"]
    ODOO["Odoo CRM"]
  end

  subgraph INTAKE["Intake — ack fast, process never"]
    direction LR
    W01["wf-01 website"]
    W02["wf-02 whatsapp"]
    W03["wf-03 csv"]
  end

  subgraph CORE["Processing"]
    W10["wf-10 pipeline-core<br/>validate / dedup / enrich<br/>score / classify / route"]
    W40["wf-40 booking-webhook"]
    W41["wf-41 approval-callback"]
  end

  subgraph CHOKE["Side-effect choke points — single writer each"]
    W20["wf-20 outbound-dispatch<br/>claim / commit / reconcile"]
    W21["wf-21 odoo-sync<br/>monotonic stage lattice"]
  end

  subgraph SCHED["Time"]
    W30["wf-30 scheduler-tick<br/>cron 1m — lease + revalidate<br/>retries / follow-ups / SLA / expiry"]
  end

  subgraph RECOV["Recovery"]
    W50["wf-50 error-handler<br/>Error Trigger"]
    W51["wf-51 dlq-reprocess<br/>manual, key-safe replay"]
  end

  subgraph DB["Postgres — leadops"]
    direction LR
    T_LEAD["lead"]
    T_EVT["lead_source_event<br/>unique source_event_key"]
    T_IDEM["idempotency_claim"]
    T_WQ["work_queue"]
    T_DLQ["dead_letter"]
    T_DUP["duplicate_decision"]
    T_REP["sales_rep"]
    T_APR["approval_request"]
    T_LOG["event_log — append only"]
  end

  subgraph HUMAN["Human checkpoints"]
    direction LR
    H1{{"VIP approval gate"}}
    H2{{"Duplicate review"}}
    H3{{"AI / rules conflict review"}}
    H4{{"Data completion"}}
    H5{{"DLQ operator replay"}}
  end

  SWEB --> W01
  SWA --> W02
  SCSV --> W03
  CAL --> W40
  MGR --> W41

  W01 --> T_EVT
  W02 --> T_EVT
  W03 --> T_EVT
  T_EVT --> T_WQ

  T_WQ --> W30
  W30 --> W10
  W30 --> W20
  W30 --> W21

  W10 -.-> T_LEAD
  W10 -.-> T_DUP
  W10 --> ENR
  W10 --> LLM
  W10 --> T_WQ

  W10 --> H2
  W10 --> H3
  W10 --> H4
  W10 --> H1
  H1 -.-> T_APR
  W41 -.-> T_APR
  W41 --> W21

  W40 -.-> T_IDEM
  W40 --> W21
  W40 --> W20

  W20 -.-> T_IDEM
  W20 --> MSG
  W21 -.-> T_IDEM
  W21 --> ODOO

  W50 --> T_DLQ
  T_DLQ --> H5
  H5 --> W51
  W51 --> T_WQ

  W10 -.-> T_LOG
  W20 -.-> T_LOG
  W21 -.-> T_LOG
  W30 -.-> T_LOG
  W30 -.-> T_REP

  classDef human fill:#fde68a,stroke:#b45309,color:#1c1917
  classDef choke fill:#bfdbfe,stroke:#1d4ed8,color:#0c1a3d
  classDef store fill:#e5e7eb,stroke:#4b5563,color:#111827
  class H1,H2,H3,H4,H5 human
  class W20,W21 choke
  class T_LEAD,T_EVT,T_IDEM,T_WQ,T_DLQ,T_DUP,T_REP,T_APR,T_LOG store
