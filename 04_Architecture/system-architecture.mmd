%% System architecture. Read left to right: a lead enters at the far left and every
%% external effect leaves at the far right. Solid arrows carry work, dotted arrows are
%% reads and writes against Postgres. Every workflow shown reads and writes that store;
%% only the queue edge is drawn, because drawing all of them obscures the flow.
flowchart TB

  subgraph SRC["Sources, all mocked"]
    direction TB
    S1["Website form"]
    S2["WhatsApp inbound"]
    S3["CSV / manual import"]
    S4["Calendar / booking provider"]
  end

  subgraph IN["Intake: acknowledge fast, process never"]
    direction TB
    W01["wf-01 website"]
    W02["wf-02 whatsapp"]
    W03["wf-03 csv"]
  end

  Q{{"work_queue<br/>durable, at-least-once<br/>leases expire and work is redelivered"}}

  W10["wf-10 pipeline-core<br/>dedup · enrich · score<br/>classify · route · assign<br/><br/>no external writes"]

  subgraph DISP["Side-effect choke points: one writer each"]
    direction TB
    W20["wf-20 outbound-dispatch<br/>the only sender<br/>claim · call · commit"]
    W21["wf-21 odoo-sync<br/>the only CRM writer<br/>monotonic stage lattice"]
  end

  subgraph PROV["Providers, mocked and fault-injectable"]
    direction TB
    P1["Enrichment API"]
    P2["LLM classifier"]
    P3["WhatsApp / email"]
    P4["Odoo CRM"]
  end

  W30["wf-30 scheduler-tick<br/>cron 1m<br/>follow-ups · SLA · expiry<br/><br/>re-reads state at dispatch"]

  subgraph EV["Inbound events"]
    direction TB
    W40["wf-40 booking<br/>keyed on provider booking id"]
    W41["wf-41 approval<br/>keyed on approval token"]
  end

  subgraph REC["Recovery"]
    direction TB
    W50["wf-50 error-handler"]
    W51["wf-51 dlq-reprocess<br/>succeeded claims never re-fire"]
  end

  DB[("Postgres<br/>lead · idempotency_claim · event_log<br/>duplicate_decision · approval_request · sales_rep<br/><br/>also holds work_queue and dead_letter,<br/>drawn separately above")]

  CON["Operator console<br/>summary · timelines · approvals · replay"]

  HUM{{"Human checkpoints<br/>VIP approval · duplicate review<br/>AI conflict · data completion · DLQ replay"}}

  S1 --> W01
  S2 --> W02
  S3 --> W03
  W01 --> Q
  W02 --> Q
  W03 --> Q

  Q --> W10
  W10 -- "enqueues effects" --> Q
  Q --> W20
  Q --> W21
  Q --> W30
  W30 -- "reschedules" --> Q

  W10 --> P1
  W10 --> P2
  W20 --> P3
  W21 --> P4

  S4 --> W40
  W40 --> Q
  W41 --> Q
  W10 -. "unhandled failure" .-> W50
  W20 -. "unhandled failure" .-> W50
  W50 --> DB
  W51 --> Q

  W01 -.-> DB
  Q -.-> DB
  DB -.-> CON
  CON --> HUM
  HUM --> W41
  HUM --> W51

  classDef choke fill:#bfdbfe,stroke:#1d4ed8,color:#0c1a3d,stroke-width:2px
  classDef human fill:#fde68a,stroke:#b45309,color:#1c1917,stroke-width:2px
  classDef store fill:#e5e7eb,stroke:#4b5563,color:#111827,stroke-width:2px
  classDef queue fill:#dcfce7,stroke:#15803d,color:#052e16,stroke-width:2px
  classDef core fill:#ede9fe,stroke:#6d28d9,color:#1e1b4b,stroke-width:2px

  class W20,W21 choke
  class HUM human
  class DB store
  class Q queue
  class W10,W30 core
  class CON store
